{
  "name": "pinrail-plugins",
  "private": true,
  "description": "Pinrail's official plugins, tested under the pinrail-sdk harness",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "test": "node --test plugins/*/tests/*.test.cjs scripts/*.test.mjs && NODE_PATH=node_modules playwright test",
    "screenshot": "node scripts/screenshot.mjs",
    "format": "git ls-files -z '*.html' '*.js' '*.mjs' '*.cjs' '*.ts' '*.css' | xargs -0 prettier --write",
    "format:check": "git ls-files -z '*.html' '*.js' '*.mjs' '*.cjs' '*.ts' '*.css' | xargs -0 prettier --check"
  },
  "devDependencies": {
    "pinrail-sdk": "^1.0.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9"
  }
}
