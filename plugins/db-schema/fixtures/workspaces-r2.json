    "sql": "create extension if not exists citext;\ncreate type membership_role as enum ('owner', 'admin', 'member');\n\nalter table users alter column email type citext;\n\ncreate table workspaces (\n  id bigint generated always as identity primary key,\n  name text not null,\n  slug text not null unique,\n  personal boolean not null default false,\n  created_at timestamptz not null default now()\n);\n\ncreate table memberships (\n  workspace_id bigint not null references workspaces (id) on delete cascade,\n  user_id bigint not null references users (id) on delete cascade,\n  role membership_role not null default 'member',\n  joined_at timestamptz not null default now(),\n  primary key (workspace_id, user_id)\n);\ncreate index memberships_user on memberships (user_id);\n\ncreate table invitations (\n  id bigint generated always as identity primary key,\n  workspace_id bigint not null references workspaces (id) on delete cascade,\n  email citext not null,\n  role membership_role not null default 'member',\n  invited_by bigint references users (id) on delete set null,\n  token text not null unique,\n  expires_at timestamptz not null,\n  accepted_at timestamptz\n);\ncreate unique index invitations_open on invitations (workspace_id, email) where accepted_at is null;\n\nalter table projects add column workspace_id bigint references workspaces (id) on delete restrict;\n\n-- one personal workspace per user, holding their projects\ninsert into workspaces (name, slug, personal)\nselect u.name, 'u-' || u.id, true from users u;\ninsert into memberships (workspace_id, user_id, role)\nselect w.id, u.id, 'owner' from users u join workspaces w on w.slug = 'u-' || u.id;\nupdate projects p set workspace_id = w.id from workspaces w where w.slug = 'u-' || p.owner_id;\n\nalter table projects alter column workspace_id set not null;\ncreate index projects_workspace on projects (workspace_id);\ndrop index projects_owner;\nalter table projects drop column owner_id;\n\ncreate index tasks_open_by_assignee on tasks (project_id, assignee_id, created_at desc)\n  include (title, done_at) where done_at is null;\ncreate index tasks_title_search on tasks using gin (to_tsvector('simple', title));\n",
    "replies": [
